model: Insert_Company/Insert_Model

base:
  - key: Insert_Publisher_Lowercase/Insert_Repo_Lowercase
    sources:
      - type: huggingface
        user: Insert_Publisher
        repo: Insert_Repo

config:
  operation:
    fields:
      - key: llm.prediction.temperature
        value: Insert_Temperature

      - key: llm.prediction.topKSampling
        value: Insert_TopK

      - key: llm.prediction.topPSampling
        value:
          checked: Insert_True_Or_False
          value: Insert_TopP

      - key: llm.prediction.minPSampling
        value:
          checked: Insert_True_Or_False
          value: Insert_MinP

      - key: llm.prediction.repeatPenalty
        value:
          checked: Insert_True_Or_False
          value: Insert_RepeatPenalty

      - key: llm.prediction.llama.presencePenalty
        value:
          checked: Insert_True_Or_False
          value: Insert_PresencePenalty

      - key: llm.prediction.reasoning.parsing
        value:
          enabled: Insert_True_Or_False
          startString: "Insert_Start_String"
          endString: "Insert_End_String"

customFields:
  - key: enableThinking
    displayName: Enable Thinking
    description: Controls whether the model will think before replying
    type: boolean
    defaultValue: Insert_True_Or_False
    effects:
      - type: setJinjaVariable
        variable: enable_thinking

  - key: clearThinking
    displayName: Clear Thinking
    description: Controls whether thinking content is cleared from history
    type: boolean
    defaultValue: Insert_True_Or_False
    effects:
      - type: setJinjaVariable
        variable: clear_thinking

  - key: truncateThinkingHistory
    displayName: Truncate Thinking History
    description: Controls whether thinking history will be truncated to save context space
    type: boolean
    defaultValue: Insert_True_Or_False
    effects:
      - type: setJinjaVariable
        variable: truncate_history_thinking

  - key: keepCots
    displayName: Keep CoT
    description: Include Chain of Thought in subsequent requests
    type: boolean
    defaultValue: Insert_True_Or_False
    effects:
      - type: setJinjaVariable
        variable: keep_cots

  - key: lowEffort
    displayName: Low Effort
    description: Controls whether the model uses low reasoning effort
    type: boolean
    defaultValue: Insert_True_Or_False
    effects:
      - type: setJinjaVariable
        variable: low_effort

  - key: reasoningEffort
    displayName: Reasoning Effort
    description: Controls how much reasoning the model should perform.
    type: select
    defaultValue: Insert_Default_Option
    options:
      - value: Insert_Option_Value
        label: Insert_Option_Label
    effects:
      - type: setJinjaVariable
        variable: reasoning_effort

  - key: thinkingBudget
    displayName: Thinking Budget
    description: Sets the maximum number of tokens the model can use for internal reasoning
    type: select
    defaultValue: Insert_Default_Option
    options:
      - value: Insert_Option_Value
        label: Insert_Option_Label
    effects:
      - type: setJinjaVariable
        variable: thinking_budget

metadataOverrides:
  domain: llm

  architectures:
    - Insert_Architecture

  compatibilityTypes:
    - Insert_Compat_Type

  paramsStrings:
    - Insert_Params

  minMemoryUsageBytes: Insert_Memory_Bytes

  contextLengths:
    - Insert_Context_Length

  vision: Insert_True_Or_False
  reasoning: Insert_True_Or_False
  trainedForToolUse: Insert_True_Or_False
